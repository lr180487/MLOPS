# ======================================================================
# Práctica MLOps · configuración por variables de entorno
# Copia este archivo a `.env` (la API lo lee al arrancar) o exporta las
# variables en el shell. TODO es opcional: sin ninguna variable la API
# arranca con SQLite + caché LRU local.
# ======================================================================

# --- Persistencia (PostgreSQL) -----------------------------------------
# Si se define y la conexión funciona → PostgreSQL.
# Si no se define, falla la conexión o falta psycopg → fallback a SQLite.
# DATABASE_URL=postgresql://usuario:password@localhost:5432/mlops
# SQLITE_PATH=storage/mlops.sqlite3
# DB_CONNECT_TIMEOUT_S=5

# --- Caché distribuida (Upstash Redis, API REST) ------------------------
# Nivel L2 detrás de la LRU en memoria (L1). Sin credenciales solo se usa L1.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxxxx
# CACHE_TTL_S=300
# CACHE_MAX_ITEMS=2048
# CACHE_PREFIX=mlops:

# --- Monitoreo y simulador de tráfico -----------------------------------
# METRICS_WINDOW=50
# METRICS_HISTORY=500
# SIMULATOR_ENABLED=true     # false para que no se generen predicciones sintéticas
# SIMULATOR_INTERVAL_S=2.0
# WARMUP_EVENTS=30

# LOG_LEVEL=INFO

# --- Exportaciones y URL pública ---
# STATIC_EXPORTS=true        # copias de las exportaciones en output/exportaciones/ al arrancar
# ANALISIS_PRECALCULAR=true  # precalcula los análisis por defecto de /analisis (regresión, clasificación, clustering, anomalías) al arrancar
# PUBLIC_URL=https://mi-servidor.example.com   # URL(s) públicas (coma) que el dashboard usará si se abre fuera de la API
# PORT=8000                  # puerto anunciado en dashboard/api-base.js
